{
  "framework": "nextjs",
  "buildCommand": "cd app && npm run build",
  "installCommand": "cd app && npm install",
  "outputDirectory": "app/.next",
  "functions": {
    "app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "app/api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
